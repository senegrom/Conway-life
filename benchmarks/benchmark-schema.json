{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conway Life benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp_utc",
    "engine_id",
    "workload_id",
    "generations",
    "command",
    "wall_seconds",
    "return_code",
    "host",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "engine_id": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "algorithm": {
      "type": [
        "string",
        "null"
      ]
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "topology": {
      "type": [
        "string",
        "null"
      ]
    },
    "generations": {
      "type": "integer",
      "minimum": 0
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "cold_start": {
      "type": "boolean"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "initialization_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "update_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "peak_rss_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "peak_vram_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "return_code": {
      "type": "integer"
    },
    "host": {
      "type": "object",
      "required": [
        "platform",
        "python"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "cpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "ram_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "compiler": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_flags": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "state_file",
        "sha256",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "state_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
